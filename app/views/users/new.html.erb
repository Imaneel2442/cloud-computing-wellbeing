<div class="row justify-content-center py-4">
  <div class="col-md-6 col-sm-10">
    <div class="wb-card p-4 p-md-5 fade-up">
      <div class="text-center mb-4">
        <div style="font-size:2.5rem; margin-bottom:8px">🌱</div>
        <h2 class="wb-title mb-1" style="font-size:1.9rem">
          Rejoins <span class="wb-title-italic" style="color:var(--wb-sage)">Wellbeing</span>
        </h2>
        <p class="wb-muted">Crée ton compte et commence ton parcours bien-être.</p>
      </div>

      <% if @user&.errors&.any? %>
        <div class="wb-flash-danger mb-4">
          <div class="fw-semibold mb-1">Veuillez corriger les erreurs :</div>
          <ul class="mb-0 ps-3" style="font-size:.9rem">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: signup_path, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :name, "Nom complet", class: "form-label" %>
          <%= f.text_field :name, class: "form-control",
                required: true, placeholder: "Marie Dupont" %>
        </div>
        <div class="mb-3">
          <%= f.label :email, "Adresse e-mail", class: "form-label" %>
          <%= f.email_field :email, class: "form-control",
                required: true, placeholder: "marie@email.com" %>
        </div>
        <div class="mb-3">
          <%= f.label :password, "Mot de passe", class: "form-label" %>
          <%= f.password_field :password, class: "form-control",
                required: true, placeholder: "Minimum 6 caractères" %>
        </div>
        <div class="mb-4">
          <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "form-label" %>
          <%= f.password_field :password_confirmation, class: "form-control",
                required: true, placeholder: "••••••••" %>
        </div>
        <%= f.submit "Créer mon compte", class: "wb-btn wb-btn-primary w-100 justify-content-center" %>
      <% end %>

      <div class="mt-3 text-center wb-muted small">
        Déjà un compte ?
        <%= link_to "Se connecter", login_path,
              class: "fw-semibold text-decoration-none", style: "color:var(--wb-sage)" %>
      </div>
    </div>
  </div>
</div>
