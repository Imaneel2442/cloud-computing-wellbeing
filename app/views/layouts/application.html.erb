<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wellbeing — Prends soin de toi</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --wb-bg:         #faf9f6;
      --wb-cream:      #f2ede4;
      --wb-sage:       #6b8f71;
      --wb-sage-light: #a8c5ae;
      --wb-sage-dark:  #4a6b50;
      --wb-gold:       #d4a574;
      --wb-gold-light: #e8c9a0;
      --wb-rose:       #c9918a;
      --wb-rose-light: #e0b8b4;
      --wb-text:       #2c2c2c;
      --wb-muted:      #7a7a7a;
      --wb-outline:    rgba(107,143,113,.18);
      --wb-card:       rgba(255,255,255,.92);
      --wb-shadow:     0 8px 32px rgba(107,143,113,.12);
      --wb-shadow-lg:  0 20px 60px rgba(107,143,113,.18);
      --wb-radius:     20px;
      --wb-radius-sm:  14px;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body {
      background: var(--wb-bg);
      background-image:
        radial-gradient(900px 500px at 0% 0%,   rgba(107,143,113,.12), transparent 60%),
        radial-gradient(700px 400px at 100% 20%, rgba(212,165,116,.12), transparent 60%),
        radial-gradient(500px 350px at 50% 100%, rgba(201,145,138,.10), transparent 60%);
      font-family: "Outfit", system-ui, sans-serif;
      font-weight: 400;
      color: var(--wb-text);
      padding-top: 72px;
      line-height: 1.6;
    }
    @keyframes fadeInUp {
      from { opacity:0; transform:translateY(18px); }
      to   { opacity:1; transform:translateY(0); }
    }
    .fade-up   { animation: fadeInUp .5s ease both; }
    .fade-up-1 { animation: fadeInUp .5s .08s ease both; }
    .fade-up-2 { animation: fadeInUp .5s .16s ease both; }
    .fade-up-3 { animation: fadeInUp .5s .24s ease both; }
    .fade-up-4 { animation: fadeInUp .5s .32s ease both; }

    /* Navbar */
    .wb-navbar {
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      background: rgba(250,249,246,.88);
      border-bottom: 1px solid rgba(107,143,113,.15);
      box-shadow: 0 2px 24px rgba(107,143,113,.08);
    }
    .wb-brand {
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 700; font-size: 1.3rem;
      color: var(--wb-sage-dark); text-decoration: none;
      display: flex; align-items: center; gap: .6rem;
    }
    .wb-brand:hover { color: var(--wb-sage-dark); }
    .wb-logo {
      width: 36px; height: 36px;
      display: grid; place-items: center; border-radius: 10px;
      background: linear-gradient(135deg, rgba(107,143,113,.2), rgba(212,165,116,.2));
      border: 1px solid rgba(107,143,113,.25); font-size: 1.1rem;
    }
    .wb-nav-user {
      font-size: .85rem; font-weight: 600; color: var(--wb-sage-dark);
      background: rgba(107,143,113,.1); border: 1px solid rgba(107,143,113,.2);
      border-radius: 999px; padding: .35rem .8rem;
      display: inline-flex; align-items: center; gap: .4rem;
    }

    /* Shell */
    .wb-shell { max-width: 1100px; }

    /* Cards */
    .wb-card {
      background: var(--wb-card);
      border: 1px solid rgba(107,143,113,.14);
      border-radius: var(--wb-radius);
      box-shadow: var(--wb-shadow);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .wb-activity-card {
      border-radius: var(--wb-radius); overflow: hidden;
      background: rgba(255,255,255,.9);
      border: 1px solid rgba(107,143,113,.1);
      box-shadow: var(--wb-shadow);
      transition: transform .25s ease, box-shadow .25s ease;
    }
    .wb-activity-card:hover { transform: translateY(-4px); box-shadow: var(--wb-shadow-lg); }
    .wb-feature-card {
      border-radius: var(--wb-radius);
      background: rgba(255,255,255,.85);
      border: 1px solid rgba(107,143,113,.1);
      box-shadow: var(--wb-shadow);
      padding: 28px 24px;
      transition: transform .25s ease, box-shadow .25s ease; text-align: center;
    }
    .wb-feature-card:hover { transform: translateY(-4px); box-shadow: var(--wb-shadow-lg); }
    .wb-stat-card {
      border-radius: var(--wb-radius); background: rgba(255,255,255,.9);
      border: 1px solid rgba(107,143,113,.1); box-shadow: var(--wb-shadow);
      padding: 28px 20px; text-align: center; transition: transform .2s ease;
    }
    .wb-stat-card:hover { transform: translateY(-3px); }
    .wb-stat-icon { font-size: 2rem; margin-bottom: 8px; }
    .wb-stat-num  { font-size: 2.4rem; font-weight: 700; color: var(--wb-sage); font-family: "Playfair Display", serif; }

    /* Typography */
    .wb-title        { font-family: "Playfair Display", Georgia, serif; font-weight: 700; line-height: 1.2; }
    .wb-title-italic { font-family: "Playfair Display", Georgia, serif; font-style: italic; }
    .wb-muted        { color: var(--wb-muted); }

    /* Buttons */
    .wb-btn {
      border-radius: 999px; padding: .55rem 1.3rem;
      font-weight: 600; font-size: .9rem; font-family: "Outfit", sans-serif;
      transition: transform .18s ease, box-shadow .18s ease, opacity .18s;
      display: inline-flex; align-items: center; gap: .4rem;
      border: none; cursor: pointer; text-decoration: none;
    }
    .wb-btn:hover { transform: translateY(-2px); text-decoration: none; }
    .wb-btn-primary {
      background: linear-gradient(135deg, var(--wb-sage), var(--wb-sage-light));
      color: #fff; box-shadow: 0 4px 16px rgba(107,143,113,.35);
    }
    .wb-btn-primary:hover { color: #fff; box-shadow: 0 6px 22px rgba(107,143,113,.45); }
    .wb-btn-gold {
      background: linear-gradient(135deg, var(--wb-gold), var(--wb-gold-light));
      color: #fff; box-shadow: 0 4px 16px rgba(212,165,116,.35);
    }
    .wb-btn-gold:hover { color: #fff; }
    .wb-btn-rose { background: linear-gradient(135deg, var(--wb-rose), var(--wb-rose-light)); color: #fff; }
    .wb-btn-rose:hover { color: #fff; }
    .wb-btn-outline {
      background: rgba(255,255,255,.8);
      border: 1.5px solid rgba(107,143,113,.3) !important;
      color: var(--wb-sage-dark);
    }
    .wb-btn-outline:hover { background: rgba(107,143,113,.08); color: var(--wb-sage-dark); }
    .wb-btn-ghost { background: transparent; border: none; color: var(--wb-muted); padding: .4rem .8rem; }
    .wb-btn-ghost:hover { background: rgba(107,143,113,.08); color: var(--wb-sage); }
    .wb-btn-danger { background: #e05c5c; color: #fff; box-shadow: 0 4px 14px rgba(224,92,92,.3); }
    .wb-btn-danger:hover { color: #fff; box-shadow: 0 6px 20px rgba(224,92,92,.4); }

    /* Chips */
    .wb-chip {
      border-radius: 999px; border: 1.5px solid rgba(107,143,113,.2);
      background: rgba(255,255,255,.8); padding: .42rem 1rem;
      text-decoration: none; color: var(--wb-text);
      display: inline-flex; align-items: center; gap: .4rem;
      font-weight: 500; font-size: .88rem; transition: all .18s ease;
    }
    .wb-chip:hover { background: rgba(107,143,113,.1); border-color: rgba(107,143,113,.4); color: var(--wb-sage-dark); transform: translateY(-1px); }
    .wb-chip.active { background: var(--wb-sage); border-color: var(--wb-sage); color: #fff; }
    .wb-chip.active:hover { color: #fff; }

    /* Tags */
    .wb-tag { padding: 3px 10px; border-radius: 999px; background: rgba(107,143,113,.12); color: var(--wb-sage-dark); font-weight: 600; font-size: .78rem; }

    /* Flash alerts */
    .wb-flash-success {
      border-left: 4px solid var(--wb-sage); background: rgba(107,143,113,.08);
      color: var(--wb-sage-dark); border-radius: 0 var(--wb-radius-sm) var(--wb-radius-sm) 0;
      padding: .85rem 1.2rem; font-weight: 500;
    }
    .wb-flash-danger {
      border-left: 4px solid var(--wb-rose); background: rgba(201,145,138,.08);
      color: #8b4040; border-radius: 0 var(--wb-radius-sm) var(--wb-radius-sm) 0;
      padding: .85rem 1.2rem; font-weight: 500;
    }

    /* Empty state */
    .wb-empty {
      text-align: center; background: rgba(255,255,255,.8);
      border: 1.5px dashed rgba(107,143,113,.25);
      border-radius: var(--wb-radius); padding: 60px 24px;
    }
    .wb-empty-icon { font-size: 3.2rem; margin-bottom: 14px; }

    /* Hero mini */
    .wb-hero-mini {
      background: linear-gradient(135deg, rgba(107,143,113,.07), rgba(212,165,116,.06));
      border-radius: var(--wb-radius); border: 1px solid rgba(107,143,113,.1);
      padding: 28px 32px; margin-bottom: 1.5rem;
    }

    /* Activity card internals */
    .wb-activity-top  { padding: 30px 16px 22px; text-align: center; }
    .wb-emoji         { font-size: 3rem; line-height: 1; display: block; }
    .wb-activity-body { padding: 18px 20px 20px; }
    .wb-card-title    { font-family: "Playfair Display", serif; font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--wb-text); }
    .wb-card-desc     { margin: 8px 0 12px; color: var(--wb-muted); line-height: 1.55; font-size: .9rem; min-height: 40px; }
    .wb-meta          { display:flex; flex-wrap:wrap; gap:10px; color:rgba(0,0,0,.48); font-weight:500; font-size:.85rem; }

    /* Stats banner */
    .wb-stats-banner { background: linear-gradient(135deg, var(--wb-sage), var(--wb-sage-dark)); border-radius: var(--wb-radius); padding: 40px 32px; color: #fff; }

    /* Steps */
    .wb-step-icon {
      width: 56px; height: 56px; border-radius: 50%;
      background: rgba(107,143,113,.1); border: 2px solid rgba(107,143,113,.2);
      display: grid; place-items: center; font-size: 1.5rem; margin: 0 auto 14px;
    }

    /* Forms */
    .form-control, .form-select {
      border-radius: var(--wb-radius-sm); border: 1.5px solid rgba(107,143,113,.2);
      background: rgba(255,255,255,.9); font-family: "Outfit", sans-serif;
      font-size: .95rem; padding: .6rem .9rem;
      transition: border-color .15s, box-shadow .15s;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--wb-sage-light); box-shadow: 0 0 0 3px rgba(107,143,113,.15); outline: none;
    }
    .form-label { font-weight: 600; font-size: .88rem; color: var(--wb-text); margin-bottom: .4rem; }

    /* Footer */
    .wb-footer { padding: 32px 0; margin-top: 40px; }
    .wb-footer-inner { border-top: 1px solid rgba(107,143,113,.15); padding-top: 28px; color: var(--wb-muted); font-size: .88rem; }

    @media (max-width: 576px) {
      .wb-hero-mini { padding: 20px 18px; }
      .wb-stat-num  { font-size: 1.9rem; }
      .wb-stats-banner { padding: 28px 20px; }
    }
  </style>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
</head>

<body>
  <nav class="navbar fixed-top wb-navbar py-2">
    <div class="container wb-shell">
      <a class="wb-brand" href="/">
        <span class="wb-logo">🌿</span>
        Wellbeing
      </a>
      <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
        <a class="wb-btn wb-btn-ghost btn-sm" href="/activities">
          <i class="bi bi-grid-3x3-gap"></i>
          <span class="d-none d-sm-inline">Activités</span>
        </a>
        <% if logged_in? %>
          <a class="wb-btn wb-btn-ghost btn-sm" href="/dashboard">
            <i class="bi bi-speedometer2"></i>
            <span class="d-none d-sm-inline">Dashboard</span>
          </a>
          <a class="wb-btn wb-btn-ghost btn-sm" href="/reservations">
            <i class="bi bi-calendar-check"></i>
            <span class="d-none d-sm-inline">Réservations</span>
          </a>
          <span class="wb-nav-user d-none d-md-inline-flex">
            <i class="bi bi-person-circle"></i>
            <%= current_user.name.split(" ").first %>
          </span>
          <%= button_to logout_path, method: :delete,
                class: "wb-btn wb-btn-danger btn-sm",
                form: { style: "margin:0" } do %>
            <i class="bi bi-box-arrow-right"></i>
            <span class="d-none d-sm-inline">Déconnexion</span>
          <% end %>
        <% else %>
          <a class="wb-btn wb-btn-outline btn-sm" href="/login">
            <i class="bi bi-box-arrow-in-right"></i>
            <span class="d-none d-sm-inline">Connexion</span>
          </a>
          <a class="wb-btn wb-btn-primary btn-sm" href="/signup">
            <i class="bi bi-person-plus"></i>
            <span class="d-none d-sm-inline">Inscription</span>
          </a>
        <% end %>
      </div>
    </div>
  </nav>

  <div class="container wb-shell mt-3">
    <% if notice %>
      <div class="wb-flash-success fade-up mb-2" role="alert">
        <i class="bi bi-check-circle me-2"></i><%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="wb-flash-danger fade-up mb-2" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i><%= alert %>
      </div>
    <% end %>
  </div>

  <main class="container wb-shell py-3">
    <%= yield %>
  </main>

  <footer class="wb-footer">
    <div class="container wb-shell">
      <div class="wb-footer-inner text-center">
        <div class="mb-1 fw-semibold" style="color:var(--wb-sage-dark)">🌿 Wellbeing</div>
        <div>Application de bien-être &middot; Rails 7.1 + PostgreSQL &middot; Docker + Azure</div>
        <div class="mt-2">
          <%= link_to "Activités", activities_path, class: "link-secondary me-3 text-decoration-none small" %>
          <% if logged_in? %>
            <%= link_to "Dashboard", dashboard_path, class: "link-secondary me-3 text-decoration-none small" %>
            <%= link_to "Mes réservations", reservations_path, class: "link-secondary text-decoration-none small" %>
          <% else %>
            <%= link_to "Se connecter", login_path, class: "link-secondary me-3 text-decoration-none small" %>
            <%= link_to "S'inscrire", signup_path, class: "link-secondary text-decoration-none small" %>
          <% end %>
        </div>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
